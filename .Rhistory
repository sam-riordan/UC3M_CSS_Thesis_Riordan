actor_labs <- c(downstream = "Downstream\n(individual)",
midstream  = "Midstream\n(community)",
upstream   = "Upstream\n(government)")
plot_df <- emm_act_lev |>
summary(infer = TRUE, type = "response") |>
as_tibble() |>
rename(any_of(c(rate = "response",
lower.CL = "asymp.LCL",
upper.CL = "asymp.UCL"))) |>
mutate(actor = factor(actor_labs[as.character(actor)],
levels = actor_labs),
level = factor(level,
levels = c("high_cog", "low_cog"),
labels = c("High complexity",
"Low complexity")))
# Check: do the six estimates sum to 1? If not, they are not shares,
# and the axis title / caption should say what they are.
message("Sum of estimates: ", round(sum(plot_df$rate), 3))
library(ggplot2)
library(scales)
actor_labs <- c(downstream = "Downstream\n(individual)",
midstream  = "Midstream\n(community)",
upstream   = "Upstream\n(government)")
plot_df <- emm_act_lev |>
summary(infer = TRUE, type = "response") |>
as_tibble() |>
rename(any_of(c(rate = "response",
lower.CL = "asymp.LCL",
upper.CL = "asymp.UCL"))) |>
mutate(actor = factor(actor_labs[as.character(actor)],
levels = actor_labs),
level = factor(level,
levels = c("high_cog", "low_cog"),
labels = c("High complexity",
"Low complexity")))
tot <- sum(plot_df$rate)
plot_df <- plot_df |>
mutate(across(c(rate, lower.CL, upper.CL), ~ .x / tot))
# connectors between the two complexity points within each actor
seg_df <- plot_df |>
select(actor, level, rate) |>
pivot_wider(names_from = level,
values_from = rate)
# rate ratios pulled straight tab_split (low / high per actor)
rr_df <- tab_split |>
as_tibble() |>
transmute(actor = factor(actor_labs[as.character(actor)],
levels = actor_labs),
label = paste0("\u00d7", number(ratio, accuracy = .01))) |>
left_join(seg_df, by = "actor") |>
mutate(x = (`Low complexity` + `High complexity`) / 2)
ggplot(plot_df, aes(x = rate, y = actor)) +
geom_vline(xintercept = 1/6,
linetype = "dashed",
colour = "grey60",
linewidth = .4) +
geom_segment(data = seg_df,
aes(x = `High complexity`,
xend = `Low complexity`,
y = actor, yend = actor),
colour = "grey80",
linewidth = 1.8,
inherit.aes = FALSE) +
geom_linerange(aes(xmin = lower.CL,
xmax = upper.CL,
colour = level),
linewidth = 2.6,
alpha = .35) +
geom_point(aes(colour = level), size = 3.6) +
geom_text(aes(label = percent(rate, accuracy = .1),
colour = level),
vjust = -1.3,
size = 3.1,
fontface = "bold",
show.legend = FALSE) +
geom_text(data = rr_df,
aes(x = x, y = actor, label = label),
vjust = 2.4,
size = 3,
colour = "grey35",
inherit.aes = FALSE) +
annotate("text",
x = 1/6, y = 3.45,
label = "uniform selection (1/6)",
hjust = -.08, size = 3, colour = "grey45") +
scale_x_continuous(labels = percent_format(accuracy = 1),
limits = c(0, .40),
expand = expansion(mult = c(0, .02))) +
scale_colour_manual(values = c("Low complexity"  = "#D55E00",
"High complexity" = "#0072B2")) +
labs(x = "Estimated selection share of fixed budget (95% CI)",
y = NULL,
colour = NULL,
title = "Upstream, Low Cognitive Complexity Activities Dominate Model Selections",
subtitle = "Connection length shows the within-actor cognitive complexity split (rate ratio, low / high);\nwhere direction reverses moving down the actor hierarchy") +
theme_minimal(base_size = 12) +
theme(legend.position = "top",
legend.justification = "left",
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank(),
plot.title = element_text(face = "bold", size = 13),
plot.subtitle = element_text(colour = "grey35", size = 9.5),
plot.margin = margin(8, 16, 8, 8))
ggsave("fig_1.png", width = 7.5, height = 4.6, dpi = 300)
