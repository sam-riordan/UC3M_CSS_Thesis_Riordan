library(dplyr)
library(stringr)
library(ggplot2)
library(scales)
thr <- 1.50   # RR threshold used for the split contrasts
model_labs <- function(x) {
x <- str_to_lower(str_remove_all(x, "[()]"))
case_when(str_detect(x, "gemini") ~ "Gemini Flash-3.8",
str_detect(x, "gpt")    ~ "GPT-Terra",
str_detect(x, "sonnet") ~ "Sonnet 5",
TRUE                    ~ x)
}
relabel_pair <- function(lab) {
parts <- str_split_fixed(lab, " / ", 2)
paste(model_labs(parts[, 1]), "/", model_labs(parts[, 2]))
}
actor_labs <- c(upstream   = "Upstream (government)",
midstream  = "Midstream (community)",
downstream = "Downstream (individual)")
fig_df <- tab_split_model$pairs |>
rename(any_of(c(lower.CL = "asymp.LCL",
upper.CL = "asymp.UCL"))) |>
rename(pair = starts_with("model")) |>
mutate(pair  = relabel_pair(as.character(pair)),
actor = factor(actor_labs[as.character(actor)], levels = actor_labs),
status = case_when(q < .05 & (ratio >= thr | ratio <= 1/thr) ~ "Significant, beyond threshold",
q < .05                                    ~ "Significant, within threshold",
TRUE                                       ~ "Not significant"),
status = factor(status, levels = c("Significant, beyond threshold",
"Significant, within threshold",
"Not significant")),
pair = factor(pair, levels = rev(unique(pair))))
stopifnot(!anyNA(fig_df$actor))
ggplot(fig_df, aes(x = ratio, y = pair, colour = status)) +
annotate("rect", xmin = 1/thr, xmax = thr, ymin = -Inf, ymax = Inf,
fill = "grey92") +
geom_vline(xintercept = 1, linetype = "dashed",
colour = "grey55", linewidth = .4) +
geom_linerange(aes(xmin = lower.CL, xmax = upper.CL), linewidth = 1.1) +
geom_point(size = 2.8) +
geom_text(aes(x = upper.CL, label = number(ratio, accuracy = .01)),
hjust = -.25, size = 2.8, show.legend = FALSE) +
facet_grid(actor ~ ., scales = "free_y", space = "free_y", switch = "y") +
scale_x_log10(breaks = c(.25, .5, 1, 2, 4),
labels = c("0.25", "0.5", "1", "2", "4"),
expand = expansion(mult = c(.05, .12))) +
scale_colour_manual(values = c("Significant, beyond threshold" = "#D55E00",
"Significant, within threshold" = "#0072B2",
"Not significant"               = "grey60"),
drop = FALSE) +
labs(x = "Ratio of low / high splits between models (log scale, 95% CI)",
y = NULL, colour = NULL,
title = "The Cognitive Complexity Split Differs Sharply Between Models",
subtitle = paste0("Values above 1: the first model's split is more low-weighted; ",
"shaded band shows the RR 1/", thr, " to ", thr, " threshold"),
caption = "q values BH-adjusted across the nine contrasts. Estimates average over instruction type.") +
theme_minimal(base_size = 11) +
theme(legend.position = "top",
legend.justification = "left",
strip.placement = "outside",
strip.text.y.left = element_text(angle = 0, face = "bold", hjust = 1),
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank(),
panel.spacing.y = unit(.8, "lines"),
plot.title = element_text(face = "bold", size = 13),
plot.subtitle = element_text(colour = "grey35", size = 9),
plot.caption = element_text(colour = "grey45", size = 8, hjust = 0),
plot.margin = margin(8, 16, 8, 8))
ggsave("fig_table8_split_contrasts.png", width = 8, height = 5.5, dpi = 300)
