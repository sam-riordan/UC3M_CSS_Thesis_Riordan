# Check if the cog complexity selection differs across models / instructions within each actor?
split_by <- function(fac) {
ic <- emmeans(fit_cell,
as.formula(paste("~ level *", fac, "| actor")),
offset = 0,
data = data_cells,
nesting = NULL) |>
contrast(interaction = c("trt.vs.ctrl", "pairwise"),
by = "actor",
adjust = "none")
list(omnibus = test(ic, joint = TRUE,
by = "actor"),
pairs = summary(ic, infer = TRUE,
type = "response") |>
as_tibble() |>
mutate(q = p.adjust(p.value,
method = "BH")))
}
tab_8_split_model <- split_by("model")# 3 actors x 3 model pairs
tab_8_split_model
